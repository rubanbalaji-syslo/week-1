BT /F3 6.7 Tf 45 557 Td (        if \(text.charAt\(left\) != text.charAt\(right\)\) return false;) Tj ET
BT /F3 6.7 Tf 45 548 Td (        return recursiveCheck\(text, left + 1, right - 1\);) Tj ET
BT /F3 6.7 Tf 45 539 Td (    }) Tj ET
BT /F3 6.7 Tf 45 530 Td (    static boolean isPalindromeArrayReversal\(String text\) {) Tj ET
BT /F3 6.7 Tf 45 521 Td (        char[] chars = text.toCharArray\(\);) Tj ET
