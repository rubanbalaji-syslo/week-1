BT /F3 6.7 Tf 45 647 Td (        if \(\(playerMove.equals\("Rock"\) && computerMove.equals\("Scissors"\)\)) Tj ET
BT /F3 6.7 Tf 45 638 Td (            || \(playerMove.equals\("Paper"\) && computerMove.equals\("Rock"\)\)) Tj ET
BT /F3 6.7 Tf 45 629 Td (            || \(playerMove.equals\("Scissors"\) && computerMove.equals\("Paper"\)\)\)) Tj ET
