BT /F3 6.7 Tf 45 683 Td (public class Main {) Tj ET
BT /F3 6.7 Tf 45 674 Td (    static String getBmiStatus\(double bmi\) {) Tj ET
BT /F3 6.7 Tf 45 665 Td (        if \(bmi < 18.5\) return "Underweight";) Tj ET
BT /F3 6.7 Tf 45 656 Td (        if \(bmi < 25.0\) return "Normal";) Tj ET
BT /F3 6.7 Tf 45 647 Td (        if \(bmi < 30.0\) return "Overweight";) Tj ET
BT /F3 6.7 Tf 45 638 Td (        return "Obese";) Tj ET
BT /F3 6.7 Tf 45 629 Td (    }) Tj ET
BT /F3 6.7 Tf 45 620 Td (    static void printWellnessReport\(double[] heights, double[] weights\) {) Tj ET
BT /F3 6.7 Tf 45 611 Td (        if \(heights.length != weights.length\) {) Tj ET
BT /F3 6.7 Tf 45 602 Td (            System.out.println\("Heights and weights must have equal lengths"\);) Tj ET
BT /F3 6.7 Tf 45 593 Td (            return;) Tj ET
BT /F3 6.7 Tf 45 584 Td (        }) Tj ET
BT /F3 6.7 Tf 45 575 Td (        System.out.println\("Person | Height \(m\) | Weight \(kg\) | BMI | Status"\);) Tj ET
BT /F3 6.7 Tf 45 566 Td (        for \(int i = 0; i < heights.length; i++\) {) Tj ET
