BT /F3 6.7 Tf 45 548 Td (            System.out.printf\("Person %d | %.2f | %.2f | %.2f | %s%n",) Tj ET
BT /F3 6.7 Tf 45 539 Td (                i + 1, heights[i], weights[i], bmi, getBmiStatus\(bmi\)\);) Tj ET
BT /F3 6.7 Tf 45 530 Td (        }) Tj ET
BT /F3 6.7 Tf 45 521 Td (    }) Tj ET
BT /F3 6.7 Tf 45 512 Td (    public static void main\(String[] args\) {) Tj ET
