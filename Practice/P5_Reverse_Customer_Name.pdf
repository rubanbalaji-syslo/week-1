BT /F1 8.2 Tf 42 733 Td (Return a reversed copy of the customer name and print both original and reversed names without modifying) Tj ET
BT /F1 8.2 Tf 42 719 Td (the original string.) Tj ET
BT /F2 11 Tf 42 702 Td (Java Solution) Tj ET
BT /F3 6.7 Tf 45 683 Td (public class Main {) Tj ET
BT /F3 6.7 Tf 45 674 Td (    static String reverseCustomerName\(String customerName\) {) Tj ET
BT /F3 6.7 Tf 45 665 Td (        char[] chars = customerName.toCharArray\(\);) Tj ET
BT /F3 6.7 Tf 45 656 Td (        int left = 0, right = chars.length - 1;) Tj ET
BT /F3 6.7 Tf 45 647 Td (        while \(left < right\) {) Tj ET
BT /F3 6.7 Tf 45 638 Td (            char temp = chars[left];) Tj ET
BT /F3 6.7 Tf 45 629 Td (            chars[left] = chars[right];) Tj ET
BT /F3 6.7 Tf 45 620 Td (            chars[right] = temp;) Tj ET
BT /F3 6.7 Tf 45 611 Td (            left++; right--;) Tj ET
BT /F3 6.7 Tf 45 602 Td (        }) Tj ET
BT /F3 6.7 Tf 45 593 Td (        return new String\(chars\);) Tj ET
BT /F3 6.7 Tf 45 584 Td (    }) Tj ET
BT /F3 6.7 Tf 45 575 Td (    public static void main\(String[] args\) {) Tj ET
BT /F3 6.7 Tf 45 566 Td (        String customerName = "Sunil";) Tj ET
BT /F3 6.7 Tf 45 557 Td (        System.out.println\("Original Name: " + customerName\);) Tj ET
BT /F3 6.7 Tf 45 548 Td (        System.out.println\("Reversed Name: " + reverseCustomerName\(customerName\)\);) Tj ET
BT /F3 6.7 Tf 45 539 Td (    }) Tj ET
BT /F3 6.7 Tf 45 530 Td (}) Tj ET
