BT /F2 11 Tf 42 702 Td (Java Solution) Tj ET
BT /F3 6.7 Tf 45 683 Td (public class Main {) Tj ET
BT /F3 6.7 Tf 45 674 Td (    static void checkTypingAccuracy\(String original, String typed\) {) Tj ET
BT /F3 6.7 Tf 45 665 Td (        if \(original.length\(\) != typed.length\(\)\) {) Tj ET
BT /F3 6.7 Tf 45 656 Td (            System.out.println\("Inputs must have equal length"\);) Tj ET
BT /F3 6.7 Tf 45 647 Td (            return;) Tj ET
BT /F3 6.7 Tf 45 638 Td (        }) Tj ET
BT /F3 6.7 Tf 45 629 Td (        int matched = 0, firstMismatch = -1;) Tj ET
BT /F3 6.7 Tf 45 620 Td (        for \(int i = 0; i < original.length\(\); i++\) {) Tj ET
BT /F3 6.7 Tf 45 611 Td (            if \(original.charAt\(i\) == typed.charAt\(i\)\) {) Tj ET
BT /F3 6.7 Tf 45 602 Td (                matched++;) Tj ET
BT /F3 6.7 Tf 45 593 Td (            } else if \(firstMismatch == -1\) {) Tj ET
BT /F3 6.7 Tf 45 584 Td (                firstMismatch = i;) Tj ET
BT /F3 6.7 Tf 45 575 Td (            }) Tj ET
BT /F3 6.7 Tf 45 566 Td (        }) Tj ET
BT /F3 6.7 Tf 45 557 Td (        double accuracy = original.length\(\) == 0 ? 100.0) Tj ET
BT /F3 6.7 Tf 45 548 Td (            : matched * 100.0 / original.length\(\);) Tj ET
BT /F3 6.7 Tf 45 539 Td (        System.out.printf\("Matched: %d/%d | Accuracy: %.2f%% | ",) Tj ET
BT /F3 6.7 Tf 45 530 Td (            matched, original.length\(\), accuracy\);) Tj ET
BT /F3 6.7 Tf 45 521 Td (        if \(firstMismatch == -1\) {) Tj ET
BT /F3 6.7 Tf 45 512 Td (            System.out.println\("No Mismatches"\);) Tj ET
BT /F3 6.7 Tf 45 503 Td (        } else {) Tj ET
BT /F3 6.7 Tf 45 494 Td (            System.out.printf\("First Mismatch at position %d \('%c' vs '%c'\)%n",) Tj ET
BT /F3 6.7 Tf 45 485 Td (                firstMismatch + 1, original.charAt\(firstMismatch\),) Tj ET
BT /F3 6.7 Tf 45 476 Td (                typed.charAt\(firstMismatch\)\);) Tj ET
BT /F3 6.7 Tf 45 467 Td (        }) Tj ET
BT /F3 6.7 Tf 45 458 Td (    }) Tj ET
BT /F3 6.7 Tf 45 449 Td (    public static void main\(String[] args\) {) Tj ET
