BT /F2 11 Tf 42 702 Td (Java Solution) Tj ET
BT /F3 6.7 Tf 45 683 Td (public class Main {) Tj ET
BT /F3 6.7 Tf 45 674 Td (    static void checkDuplicateSeats\(int[] seatNumbers\) {) Tj ET
BT /F3 6.7 Tf 45 665 Td (        boolean found = false;) Tj ET
BT /F3 6.7 Tf 45 656 Td (        for \(int i = 0; i < seatNumbers.length; i++\) {) Tj ET
BT /F3 6.7 Tf 45 647 Td (            boolean alreadyReported = false;) Tj ET
BT /F3 6.7 Tf 45 638 Td (            for \(int k = 0; k < i; k++\) {) Tj ET
BT /F3 6.7 Tf 45 629 Td (                if \(seatNumbers[k] == seatNumbers[i]\) {) Tj ET
BT /F3 6.7 Tf 45 620 Td (                    alreadyReported = true;) Tj ET
BT /F3 6.7 Tf 45 611 Td (                    break;) Tj ET
BT /F3 6.7 Tf 45 602 Td (                }) Tj ET
BT /F3 6.7 Tf 45 593 Td (            }) Tj ET
BT /F3 6.7 Tf 45 584 Td (            if \(alreadyReported\) continue;) Tj ET
BT /F3 6.7 Tf 45 575 Td (            for \(int j = i + 1; j < seatNumbers.length; j++\) {) Tj ET
BT /F3 6.7 Tf 45 566 Td (                if \(seatNumbers[i] == seatNumbers[j]\) {) Tj ET
BT /F3 6.7 Tf 45 557 Td (                    System.out.println\("Duplicate Seat Number Found: " + seatNumbers[i]\);) Tj ET
BT /F3 6.7 Tf 45 548 Td (                    found = true;) Tj ET
BT /F3 6.7 Tf 45 539 Td (                    break;) Tj ET
BT /F3 6.7 Tf 45 530 Td (                }) Tj ET
BT /F3 6.7 Tf 45 521 Td (            }) Tj ET
BT /F3 6.7 Tf 45 512 Td (        }) Tj ET
BT /F3 6.7 Tf 45 503 Td (        if \(!found\) System.out.println\("No Duplicate Seats Found"\);) Tj ET
BT /F3 6.7 Tf 45 494 Td (    }) Tj ET
BT /F3 6.7 Tf 45 485 Td (    public static void main\(String[] args\) {) Tj ET
BT /F3 6.7 Tf 45 476 Td (        checkDuplicateSeats\(new int[]{101, 102, 103, 102, 105}\);) Tj ET
