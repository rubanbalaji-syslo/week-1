BT /F2 15 Tf 42 800 Td (The Movie Review Word Length Profiler) Tj ET
BT /F1 9 Tf 42 774 Td (Week 1 Assignment - Problem 5 | Java) Tj ET
BT /F2 11 Tf 42 752 Td (Problem Summary) Tj ET
BT /F1 8.2 Tf 42 733 Td (Split a review on whitespace and count Short words \(1-4 characters\), Medium words \(5-8 characters\), and) Tj ET
BT /F1 8.2 Tf 42 719 Td (Long words \(9 or more characters\).) Tj ET
BT /F2 11 Tf 42 702 Td (Java Solution) Tj ET
BT /F3 6.7 Tf 45 683 Td (public class Main {) Tj ET
BT /F3 6.7 Tf 45 674 Td (    static void classifyWordLengths\(String review\) {) Tj ET
BT /F3 6.7 Tf 45 665 Td (        int shortCount = 0, mediumCount = 0, longCount = 0;) Tj ET
BT /F3 6.7 Tf 45 656 Td (        String trimmed = review == null ? "" : review.trim\(\);) Tj ET
BT /F3 6.7 Tf 45 647 Td (        if \(!trimmed.isEmpty\(\)\) {) Tj ET
BT /F3 6.7 Tf 45 638 Td (            String[] words = trimmed.split\("\\\\s+"\);) Tj ET
BT /F3 6.7 Tf 45 629 Td (            for \(String word : words\) {) Tj ET
BT /F3 6.7 Tf 45 620 Td (                int length = word.length\(\);) Tj ET
BT /F3 6.7 Tf 45 611 Td (                if \(length <= 4\) shortCount++;) Tj ET
BT /F3 6.7 Tf 45 602 Td (                else if \(length <= 8\) mediumCount++;) Tj ET
BT /F3 6.7 Tf 45 593 Td (                else longCount++;) Tj ET
BT /F3 6.7 Tf 45 584 Td (            }) Tj ET
BT /F3 6.7 Tf 45 575 Td (        }) Tj ET
BT /F3 6.7 Tf 45 566 Td (        System.out.printf\("Short: %d | Medium: %d | Long: %d%n",) Tj ET
BT /F3 6.7 Tf 45 557 Td (            shortCount, mediumCount, longCount\);) Tj ET
BT /F3 6.7 Tf 45 548 Td (    }) Tj ET
BT /F3 6.7 Tf 45 539 Td (    public static void main\(String[] args\) {) Tj ET
BT /F3 6.7 Tf 45 530 Td (        classifyWordLengths\("This movie was absolutely fantastic and thrilling"\);) Tj ET
BT /F3 6.7 Tf 45 521 Td (    }) Tj ET
BT /F3 6.7 Tf 45 512 Td (}) Tj ET
